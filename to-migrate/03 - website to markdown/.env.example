# API Keys - Replace with your own keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Data directories - Change to your preferred location
DATA_DIR=./data

# Database configuration
DB_PATH=./data/documents.db
LANCEDB_URI=./data/lancedb

# Model configurations
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Chunking settings - Adjust based on your needs
MAX_CHUNK_TOKENS=8191  # Default for compatibility with embedding models

# Crawler settings
CRAWL_DELAY=0.5  # Seconds between requests
USER_AGENT=WebsiteToMarkdown/0.1.0 (Educational Purpose)
MAX_PAGES=100  # Maximum pages to crawl per domain

# Testing mode - set to true to skip API calls
TEST_MODE=false
